# Keep Docker build contexts small. The simulation image only needs the files
# referenced by docker/Dockerfile.sim*.
.git
.gitignore

# Local Python environments and caches
cvdp_env/
.venv/
venv/
__pycache__/
.pytest_cache/
*.pyc

# Local secrets and generated benchmark output
.env
work/
work*/
*.log
*.json
*.jsonl
!example_dataset/*.jsonl

# Local Claude / editor metadata
.claude/
.wolf/
.vscode/
.idea/

# Analysis outputs produced by local tooling
dataset_analysis*/
refinement_analysis*/
failure_analysis*/
model_sweep_results*/
