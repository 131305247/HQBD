# OpenAI API Key for default model
# OPENAI_USER_KEY=your_openai_api_key_here

# --- Claude / Anthropic-compatible endpoint wiring ---
# To evaluate with Claude (see claude_factory.py), set these in your LOCAL .env
# (do NOT commit real keys). CUSTOM_MODEL_FACTORY points run_benchmark at the
# factory that registers the "claude" model prefix.
# ANTHROPIC_API_KEY=sk-your_claude_or_gateway_key_here
# ANTHROPIC_AUTH_TOKEN=sk-your_claude_or_gateway_token_here
# ANTHROPIC_BASE_URL=https://sub2api.xeda.cc:8888  # optional gateway/proxy; comment out for official Anthropic API
# DEFAULT_MODEL=claude-opus-5
# CUSTOM_MODEL_FACTORY=claude_factory.py
# MODEL_TIMEOUT=300
# CLAUDE_MAX_TOKENS=16000

# --- tenyunc GLM (OpenAI-compatible endpoint) wiring ---
# To evaluate with tenyunc GLM-5.2 (see tenyunc_factory.py), set these in your
# LOCAL .env (do NOT commit real keys). CUSTOM_MODEL_FACTORY points run_benchmark
# at the factory that registers the "glm"/"GLM-5.2" model prefix.
# TENYUNC_API_KEY=sk-your_tenyunc_key_here
# TENYUNC_BASE_URL=https://preview.llm.tenyunc.com/v1
# DEFAULT_MODEL=GLM-5.2
# CUSTOM_MODEL_FACTORY=tenyunc_factory.py
# MODEL_TIMEOUT=300  # GLM-5.2 needs ~60-90s to generate full RTL; default 60 is too tight

# Custom Model Factory path (optional)
# Uncomment and set this to use your own model factory implementation
# CUSTOM_MODEL_FACTORY=your_factory.py

# Example API Keys for other model providers
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Benchmark settings (defaults shown in comments)
# BENCHMARK_THREADS=1
# BENCHMARK_PREFIX=work
# DEFAULT_MODEL=gpt-4o-mini

# Docker timeouts in seconds (defaults shown in comments)
# DOCKER_TIMEOUT=600
# DOCKER_TIMEOUT_AGENT=600
# MODEL_TIMEOUT=60
# TASK_TIMEOUT=300
# QUEUE_TIMEOUT=disabled

# Docker directory size monitoring (defaults shown in comments)
# DOCKER_QUOTA_THRESHOLD_MB=50
# DOCKER_QUOTA_CHECK_INTERVAL=1
# DOCKER_QUOTA_MIN_COMPRESS_SIZE_MB=10

# EDA Tool Infrastructure Configuration (optional)
# VERIF_EDA_IMAGE=cvdp-cadence-verif:latest
# LICENSE_NETWORK=licnetwork
# LICENSE_NETWORK_AUTO_CREATE=true
# OSS_SIM_IMAGE=nvidia/cvdp-sim:v1.0.0
# OSS_PNR_IMAGE=nvidia/cvdp-sim:v1.0.0

# Enable LLM-based subjective scoring (defaults shown in comments)
# ENABLE_SUBJECTIVE_SCORING=false 

# Path to directory containing cvdp_agentic_heavy_* local git repos or .bundle files
# Datapoint repo names resolve to either my_repo/ or my_repo.bundle.
# CVDP_HEAVY_REPOS_PATH=../../datasets/hqbd_v0.0.1/hqbd_v0.0.1_agentic_heavy_code_generation_public
